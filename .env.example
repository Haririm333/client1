# The MechLab Engineering - Environment Variables Example
# Duplicate this file as .env.local for local development.
# NEVER commit actual secrets, API keys, or production tokens to git.

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (Bot protection)
# In development, leave empty or supply your site/secret keys from Cloudflare Dashboard
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# The MechLab Dispatch Token Secret (HMAC-SHA256 signing secret, at least 32 random bytes)
# In development, a fallback test secret is used if not set.
DISPATCH_TOKEN_SECRET=replace_with_at_least_32_random_bytes_hex_or_base64_secret_key

# Brevo (Sendinblue) Email Adapter
# Leave empty or set to "mock" to use the local mock mailer in development/testing.
BREVO_API_KEY=mock
BREVO_NEWSLETTER_LIST_ID=1
BREVO_SENDER_EMAIL=themechlabengineering@gmail.com
BREVO_SENDER_NAME=The MechLab Engineering

# Studio Owner Notifications
OWNER_NOTIFICATION_EMAIL=themechlabengineering@gmail.com

# Analytics Host (optional - e.g., https://plausible.io)
NEXT_PUBLIC_ANALYTICS_HOST=
